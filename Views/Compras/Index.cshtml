@model IEnumerable<MiniMarket.Web.Models.Compra>

@{
    ViewData["Title"] = "Compras";
}

@Html.AntiForgeryToken()

<div class="amaya-page-heading">
    <div>
        <h2><i class="fas fa-truck-loading amaya-title-icon"></i>Compras</h2>
        <p class="text-muted mb-0">Registra el ingreso de mercadería y revisa el historial en una sola pantalla.</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow border-0 mb-4">
            <div class="card-header amaya-card-header">
                <h5 class="mb-0"><i class="fas fa-file-invoice me-2"></i>Datos de Compra</h5>
            </div>
            <div class="card-body">
                <form id="frmCompra">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Buscar Proveedor</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-truck"></i></span>
                            <select id="cboProveedor" class="form-select" style="width: 85%;"></select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">N° Factura / Documento</label>
                        <input type="text" class="form-control" id="txtNumeroDocumento" placeholder="Ej: F001-00045" required />
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Buscar Producto</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                            <select id="cboProducto" class="form-select" style="width: 85%;"></select>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small text-muted fw-bold">COSTO UNIT.</label>
                            <input type="number" class="form-control" id="txtPrecioCompra" step="0.01" min="0" placeholder="0.00">
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted fw-bold">CANTIDAD</label>
                            <input type="number" class="form-control" id="txtCantidad" value="1" min="1">
                        </div>
                    </div>

                    <div class="d-grid mt-3">
                        <button type="button" class="btn btn-success" id="btnAgregar">
                            <i class="fas fa-plus-circle me-2"></i> AGREGAR AL DETALLE
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header amaya-card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-boxes me-2"></i>Productos a Ingresar</h5>
                <h3 class="fw-bold text-success m-0" id="txtTotal">S/. 0.00</h3>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="ps-3">Producto</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end">Costo</th>
                                <th class="text-end">SubTotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tablaDetalle"></tbody>
                    </table>
                </div>

                <div id="emptyState" class="text-center py-5 text-muted">
                    <i class="fas fa-truck-loading fa-3x mb-3 amaya-muted-icon"></i>
                    <p>Agrega productos desde el panel izquierdo</p>
                </div>
            </div>
            <div class="card-footer bg-light text-end">
                <button class="btn btn-secondary me-2" id="btnLimpiarCompra">Limpiar</button>
                <button class="btn btn-primary btn-lg px-4" id="btnTerminar">
                    <i class="fas fa-save me-2"></i> GUARDAR INGRESO
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow border-0">
    <div class="card-header amaya-card-header">
        <h5 class="mb-0"><i class="fas fa-history me-2"></i>Historial de Compras</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="tablaCompras">
                <thead class="bg-light">
                    <tr>
                        <th>N° Documento</th>
                        <th>Proveedor</th>
                        <th>Responsable</th>
                        <th>Fecha</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark"><i class="fas fa-file-invoice text-muted me-2"></i>@item.NumeroDocumento</td>
                            <td>
                                @if (item.Proveedor != null)
                                {
                                    <span class="text-dark fw-bold">@item.Proveedor.RazonSocial</span>
                                }
                                else
                                {
                                    <span class="text-danger">Proveedor Eliminado</span>
                                }
                            </td>
                            <td><small class="text-muted">@(item.Usuario != null ? item.Usuario.UserName : "Sistema")</small></td>
                            <td data-order="@item.Fecha.ToString("yyyy-MM-ddTHH:mm:ss")">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end fw-bold text-success">S/. @item.Total.ToString("N2")</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Ver Detalles">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let _productosLista = [];
        let _total = 0;

        $(document).ready(function() {
            $('#cboProveedor').select2({
                ajax: {
                    url: '@Url.Action("BuscarProveedores", "Proveedores")',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) { return { term: params.term || '', page: params.page || 1 }; },
                    processResults: function(data) { return data; }
                },
                placeholder: 'Seleccionar o buscar proveedor...',
                minimumInputLength: 0,
                language: { noResults: () => 'No hay proveedores activos que coincidan', errorLoading: () => 'No se pudieron cargar los proveedores.' },
                theme: 'bootstrap-5',
                width: '100%'
            });

            $('#cboProducto').select2({
                ajax: {
                    url: '@Url.Action("BuscarProductos", "Compras")',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) { return { term: params.term || '', page: params.page || 1 }; },
                    processResults: function(data) { return data; }
                },
                placeholder: 'Seleccionar o buscar producto...',
                minimumInputLength: 0,
                language: { noResults: () => 'No hay productos activos que coincidan', errorLoading: () => 'No se pudieron cargar los productos.' },
                theme: 'bootstrap-5',
                width: '100%'
            });

            $('#cboProducto').on('select2:select', function(e) { $('#txtPrecioCompra').val(Number(e.params.data.precio).toFixed(2)).focus(); });

            @if (ViewBag.PreloadProductoId != null)
            {
                <text>
                let preId = @ViewBag.PreloadProductoId;
                let preNombre = @Html.Raw(Json.Serialize((string)ViewBag.PreloadNombre));
                let preCosto = @ViewBag.PreloadCosto.ToString(System.Globalization.CultureInfo.InvariantCulture);
                let preCantidad = @ViewBag.PreloadCantidad;

                _productosLista.push({
                    ProductoId: preId,
                    Nombre: preNombre,
                    Precio: preCosto,
                    Cantidad: preCantidad,
                    Total: preCosto * preCantidad
                });

                renderizarTabla();
                </text>
            }

            $('#btnAgregar').click(function() {
                let idProd = $('#cboProducto').val();
                let nombreProd = $('#cboProducto').select2('data')[0]?.nombre || $('#cboProducto option:selected').text();
                let precio = parseFloat($('#txtPrecioCompra').val());
                let cantidad = Number($('#txtCantidad').val());

                if (!idProd) { Swal.fire('Aviso', 'Seleccione un producto', 'warning'); return; }
                if (isNaN(precio) || precio <= 0) { Swal.fire('Aviso', 'Ingrese un costo válido', 'warning'); return; }
                if (!Number.isInteger(cantidad) || cantidad <= 0) { Swal.fire('Aviso', 'Ingrese una cantidad entera positiva.', 'warning'); return; }

                _productosLista.push({
                    ProductoId: idProd,
                    Nombre: nombreProd,
                    Precio: precio,
                    Cantidad: cantidad,
                    Total: precio * cantidad
                });

                renderizarTabla();
                limpiarInputsProducto();
            });

            $('#btnLimpiarCompra').click(function() {
                _productosLista = [];
                $('#txtNumeroDocumento').val('');
                $('#cboProveedor').val(null).trigger('change');
                limpiarInputsProducto();
                renderizarTabla();
            });

            $('#btnTerminar').click(function() {
                if (_productosLista.length === 0) { Swal.fire('Error', 'No hay productos en el detalle', 'error'); return; }

                let proveedorId = $('#cboProveedor').val();
                if (!proveedorId) { Swal.fire('Error', 'Seleccione un proveedor', 'error'); return; }

                let numeroDocumento = $('#txtNumeroDocumento').val().trim();
                if (!numeroDocumento) {
                    Swal.fire('Error', 'Ingrese el número de factura o documento.', 'error');
                    $('#txtNumeroDocumento').focus();
                    return;
                }

                let compraModelo = {
                    ProveedorId: proveedorId,
                    NumeroDocumento: numeroDocumento,
                    Total: Number(_total.toFixed(2)),
                    Detalles: _productosLista.map(p => ({ ...p, Total: Number(p.Total.toFixed(2)) }))
                };

                Swal.fire({
                    title: '¿Guardar Compra?',
                    text: 'Se actualizará el stock de los productos',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, Guardar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#btnTerminar').prop('disabled', true);
                        $.ajax({
                            url: '@Url.Action("Registrar", "Compras")',
                            type: 'POST',
                            contentType: 'application/json',
                            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() },
                            data: JSON.stringify(compraModelo),
                            success: function(resp) {
                                if (resp.exito) {
                                    Swal.fire('Éxito', 'Mercadería ingresada correctamente', 'success').then(() => {
                                        window.location.href = '@Url.Action("Index")';
                                    });
                                } else {
                                    Swal.fire('Error', resp.mensaje, 'error');
                                }
                            },
                            error: function() {
                                Swal.fire('Error', 'Error al procesar la solicitud', 'error');
                            },
                            complete: function() {
                                $('#btnTerminar').prop('disabled', false);
                            }
                        });
                    }
                });
            });

            if ($.fn.DataTable.isDataTable('#tablaCompras')) {
                $('#tablaCompras').DataTable().destroy();
            }

            $('#tablaCompras').DataTable({
                dom: '<"row"<"col-sm-12 col-md-4"B><"col-sm-12 col-md-4"l><"col-sm-12 col-md-4"f>>rtip',
                buttons: [
                    { extend: 'excelHtml5', text: '<i class="fas fa-file-excel"></i> Excel', className: 'btn btn-success btn-sm' },
                    { extend: 'pdfHtml5', text: '<i class="fas fa-file-pdf"></i> PDF', className: 'btn btn-danger btn-sm' }
                ],
                order: [[3, 'desc']],
                language: { url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json' }
            });
        });

        function renderizarTabla() {
            let html = '';
            _total = 0;
            if (_productosLista.length > 0) $('#emptyState').hide();
            else $('#emptyState').show();

            _productosLista.forEach((item, index) => {
                item.Precio = Number(item.Precio);
                item.Cantidad = Number(item.Cantidad);
                item.Total = Number(item.Total);
                _total += item.Total;
                html += `
                    <tr>
                        <td class="ps-3 fw-bold">${$('<div>').text(item.Nombre).html()}</td>
                        <td class="text-center">${item.Cantidad}</td>
                        <td class="text-end">${item.Precio.toFixed(2)}</td>
                        <td class="text-end fw-bold text-success">${item.Total.toFixed(2)}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger" onclick="eliminarItem(${index})"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>`;
            });

            $('#tablaDetalle').html(html);
            $('#txtTotal').text('S/. ' + _total.toFixed(2));
        }

        function eliminarItem(index) {
            _productosLista.splice(index, 1);
            renderizarTabla();
        }

        function limpiarInputsProducto() {
            $('#cboProducto').val(null).trigger('change');
            $('#txtPrecioCompra').val('');
            $('#txtCantidad').val(1);
        }
    </script>
}
