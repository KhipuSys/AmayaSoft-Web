@model IEnumerable<MiniMarket.Web.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<div class="container-fluid">
    <div class="amaya-page-heading">
        <div>
            <h2><i class="fas fa-tags amaya-title-icon"></i>Gestión de Categorías</h2>
            <p>Organiza productos por familias comerciales.</p>
        </div>
        <a asp-action="Create" class="btn amaya-primary-action btn-sm"><i class="fas fa-plus-circle me-2"></i>Nueva Categoría</a>
    </div>
    <div class="card shadow border-0">
        <div class="card-header amaya-card-header"><h5 class="mb-0">Listado de categorías</h5></div>
        <div class="card-body">
            @if (Model.Count() > 0)
            {
                <div class="table-responsive">
                <table class="table table-striped table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                            <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                            <th>@Html.DisplayNameFor(model => model.Estado)</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.Estado ? "" : "text-muted")">
                                <td class="fw-bold">@Html.DisplayFor(modelItem => item.Nombre)</td>
                                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                                <td>
                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success rounded-pill"><i class="fas fa-check me-1"></i>Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill"><i class="fas fa-ban me-1"></i>Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Editar">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        
                                        @if (item.Estado)
                                        {
                                            <form asp-action="CambiarEstado" asp-route-id="@item.Id" method="post" class="d-inline js-swal-confirm" data-swal-title="¿Desactivar categoría?" data-swal-text="La categoría quedará inactiva." data-swal-confirm="Sí, desactivar"><button class="btn btn-outline-danger btn-sm" title="Desactivar">
                                                <i class="fas fa-power-off"></i>
                                            </button></form>
                                        }
                                        else
                                        {
                                            <form asp-action="CambiarEstado" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-outline-success btn-sm" title="Activar">
                                                <i class="fas fa-check-circle"></i>
                                            </button></form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            else
            {
                <div class="amaya-soft-panel text-center py-4">
                    <i class="fas fa-info-circle fa-2x mb-3 amaya-muted-icon"></i>
                    <p>No hay categorías registradas.</p>
                </div>
            }
        </div>
    </div>
</div>
