@page
@model MiniMarket.Web.Areas.Identity.Pages.Account.LoginWith2faModel

@{
    ViewData["Title"] = "Verificación en dos pasos";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verificación 2FA - AmayaSoft</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; min-height: 100vh; margin: 0; background: #f8fafc; display: flex; align-items: center; justify-content: center; padding: 24px; }
        .auth-card { width: 100%; max-width: 430px; background: #fff; border-radius: 18px; padding: 34px; box-shadow: 0 20px 45px rgba(15, 23, 42, .12); border: 1px solid #e2e8f0; }
        .auth-icon { width: 72px; height: 72px; border-radius: 18px; background: rgba(37, 99, 235, .1); color: #2563eb; display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 18px; }
        .btn-primary { background: #2563eb; border-color: #2563eb; border-radius: 12px; padding: .85rem; font-weight: 700; }
        .form-control { border-radius: 12px; padding: .9rem 1rem; font-size: 1.1rem; letter-spacing: .2rem; text-align: center; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center">
            <div class="auth-icon"><i class="fas fa-shield-alt"></i></div>
            <h1 class="h3 fw-bold mb-2">Código de Authy</h1>
            <p class="text-muted mb-4">Ingrese el código de 6 dígitos generado por Authy para completar el ingreso.</p>
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="Input.TwoFactorCode" class="form-label fw-semibold">Código de verificación</label>
                <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="one-time-code" inputmode="numeric" maxlength="7" autofocus />
                <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Verificar e ingresar</button>
        </form>
        <div class="text-center mt-3">
            <a asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="small">Usar código de recuperación</a>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
