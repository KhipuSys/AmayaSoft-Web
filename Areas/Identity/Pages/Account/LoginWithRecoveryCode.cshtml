@page
@model MiniMarket.Web.Areas.Identity.Pages.Account.LoginWithRecoveryCodeModel

@{
    ViewData["Title"] = "Código de recuperación";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Código de recuperación - AmayaSoft</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body { min-height: 100vh; margin: 0; background: #f8fafc; display: flex; align-items: center; justify-content: center; padding: 24px; }
        .auth-card { width: 100%; max-width: 430px; background: #fff; border-radius: 18px; padding: 34px; box-shadow: 0 20px 45px rgba(15, 23, 42, .12); border: 1px solid #e2e8f0; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="fas fa-key fa-2x text-primary mb-3"></i>
            <h1 class="h3 fw-bold">Código de recuperación</h1>
            <p class="text-muted">Use uno de los códigos guardados al activar 2FA.</p>
        </div>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="Input.RecoveryCode" class="form-label fw-semibold">Código</label>
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="one-time-code" autofocus />
                <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>
    </div>
</body>
</html>
